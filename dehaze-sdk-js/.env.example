# 集成测试环境配置模板
# 复制为 .env.java / .env.python / .env.go 并填入实际值
# 或直接通过 CI 环境变量注入（CI 中系统环境变量优先级高于 .env 文件）

# 后端 API 地址
# java: http://127.0.0.1:8989
# python: http://127.0.0.1:8991
# go: http://127.0.0.1:8990
BACKEND_URL=http://127.0.0.1:8989

# 测试账号统一密码（与 sys_user.sql 种子数据一致）
TEST_PASSWORD=12345678

# Redis 配置（用于读取验证码）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=12345678
REDIS_DB=0

# 验证码 Redis key 前缀（三端统一）
CAPTCHA_KEY_PREFIX=captcha_code:
