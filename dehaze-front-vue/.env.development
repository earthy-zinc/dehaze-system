## 开发环境
NODE_ENV='development'

# 应用端口
VITE_APP_PORT=5174
VITE_ELECTRON_PORT=5184

# 代理前缀
VITE_BASE_API='/api'

# 开发接口地址
VITE_API_URL=http://127.0.0.1:8991

# 是否启用 Mock 服务
VITE_MOCK_DEV_SERVER=false

# 数据集静态文件服务地址（nginx-dataset，URL 前缀 /datasets）
# 与仓库根 .env 的 NGINX_STATIC_HOST/NGINX_STATIC_PORT 同源；本地自建静态服务可在 .env.development.local 覆盖
VITE_DATASET_HOST=http://earthyzinc.devcloud.woa.com:9000
