## 开发环境
NODE_ENV='development'

# 应用端口
VITE_APP_PORT=5174
VITE_ELECTRON_PORT=5184

# 代理前缀
VITE_JAVA_BASE_API='/java-api'
VITE_PYTHON_BASE_API='/py-api'
VITE_DATASET_BASE_API='/dataset-api'

# 开发接口地址
VITE_JAVA_API_URL=http://127.0.0.1:8989
VITE_PYTHON_API_URL=http://127.0.0.1:8991
VITE_DATASET_API_URL=http://127.0.0.1:9000
# 是否启用 Mock 服务
VITE_MOCK_DEV_SERVER=false
