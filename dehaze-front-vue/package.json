{
  "name": "dehaze-front",
  "version": "1.10.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "main": "out/main/index.js",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "electron-builder install-app-deps",
    "dev": "vite serve --mode development",
    "dev:electron": "electron-vite dev",
    "build": "vite build --mode production && vue-tsc --noEmit",
    "build:electron:win": "electron-vite build && electron-builder build --win --x64",
    "build:electron:linux": "electron-vite build && electron-builder build --linux --x64",
    "test": "pnpm test:unit && pnpm test:storybook && pnpm test:e2e",
    "test:unit": "vitest run --open=false --project unit",
    "test:unit:ui": "vitest watch --coverage --ui --project unit",
    "test:coverage": "vitest run --open=false --coverage --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:prettier",
    "lint:eslint": "eslint --fix ./src/**/*.{ts,js,vue}",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint  \"**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "commit": "git-cz",
    "storybook": "storybook dev -p 3021 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{vue,html}": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.pei.dehaze-front-desktop",
    "productName": "dehaze-front-desktop-vue",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "target"
    },
    "nsis": {
      "oneClick": false,
      "uninstallDisplayName": "卸载",
      "allowToChangeInstallationDirectory": true
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^13.9.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "5.1.10",
    "animate.css": "^4.1.1",
    "axios": "^1.13.2",
    "color": "^5.0.3",
    "dehaze-sdk-js": "link:../dehaze-tool/dehaze-sdk-js",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.0",
    "lodash-es": "^4.17.22",
    "net": "^1.0.2",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^8.3.0",
    "pinia": "^3.0.4",
    "sockjs-client": "1.6.1",
    "sortablejs": "^1.15.6",
    "stompjs": "^2.3.3",
    "v-viewer": "^3.0.22",
    "viewerjs": "^1.11.7",
    "vue": "^3.5.26",
    "vue-i18n": "11.1.12",
    "vue-router": "^4.6.4",
    "vue3-lazyload": "^0.3.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "4.1.1",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@iconify-json/ep": "^1.2.3",
    "@mdx-js/react": "^3.1.1",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "10.0.0",
    "@storybook/addon-docs": "10.0.0",
    "@storybook/addon-vitest": "10.0.0",
    "@storybook/vue3-vite": "10.0.0",
    "@types/color": "^4.2.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.4",
    "@types/nprogress": "^0.2.3",
    "@types/path-browserify": "^1.0.3",
    "@types/sockjs-client": "^1.5.4",
    "@types/sortablejs": "^1.15.9",
    "@types/stompjs": "^2.3.10",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vitest/browser-playwright": "4.0.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.23",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "electron": "^38.7.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "10.0.0",
    "eslint-plugin-vue": "^10.6.2",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "markdown-to-jsx": "^8.0.0",
    "msw": "^2.12.7",
    "msw-storybook-addon": "^2.0.6",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.7.4",
    "sass": "^1.97.1",
    "storybook": "10.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.1",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "unocss": "^66.5.11",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^7.3.0",
    "vite-plugin-mock-dev-server": "^2.0.7",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.16",
    "vitest-canvas-mock": "^0.3.3",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.1"
  },
  "repository": "",
  "author": "武沛鑫",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "msw": {
    "workerDirectory": [
      "mock"
    ]
  }
}