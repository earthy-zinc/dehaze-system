{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "clarity-sdk-js": ["../clarity-sdk-js/index.ts"]
    },
    // SDK 源码的 logger 用到 window / EventTarget / localStorage，运行时靠 isBrowser() 降级；
    // 这里保留 RN 基础 lib 的版本收敛，只追加 dom 供 SDK 源码通过类型检查
    "lib": [
      "es2019",
      "es2020.bigint",
      "es2020.date",
      "es2020.number",
      "es2020.promise",
      "es2020.string",
      "es2020.symbol.wellknown",
      "es2021.promise",
      "es2021.string",
      "es2021.weakref",
      "es2022.array",
      "es2022.object",
      "es2022.string",
      "dom"
    ]
  },
  "include": ["**/*.ts", "**/*.tsx", "index.js"],
  "exclude": ["**/node_modules", "**/Pods"]
}
