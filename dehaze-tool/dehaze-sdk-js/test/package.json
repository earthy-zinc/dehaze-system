{
  "name": "dehaze-sdk-test",
  "version": "1.0.0",
  "description": "Test project for dehaze-sdk-js",
  "packageManager": "pnpm@10.14.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "dev-server": "nodemon src/server.ts",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "dehaze",
    "sdk",
    "test"
  ],
  "author": "Dehaze Team",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "dehaze-sdk-js": "link:..",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.14",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.11.9",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.39.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.3"
  }
}
