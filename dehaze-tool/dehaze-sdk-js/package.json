{
  "name": "dehaze-sdk-js",
  "version": "1.0.0",
  "description": "JavaScript SDK for Dehaze System API",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/",
    "src/types"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:java": "cross-env TEST_BACKEND=java vitest --run",
    "test:python": "cross-env TEST_BACKEND=python vitest --run",
    "test:go": "cross-env TEST_BACKEND=go vitest --run",
    "lint": "pnpm lint:eslint && pnpm lint:prettier",
    "lint:eslint": "eslint --fix ./src/**/*.ts ./test/**/*.ts ./index.ts",
    "lint:prettier": "prettier --write \"**/*.{ts,json,cjs}\""
  },
  "keywords": [
    "dehaze",
    "sdk",
    "api",
    "typescript"
  ],
  "author": "Dehaze Team",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@types/node": "^24.8.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "axios": "^1.18.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "form-data": "^4.0.5",
    "nanoid": "^5.1.6",
    "prettier": "^3.7.4",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "axios": ">=1.12.0"
  }
}
