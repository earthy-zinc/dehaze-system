# ============================================================
# Clarity 环境变量模板 —— dev（开发环境）
#
# 用法：复制为 <仓库根>/.env 后按现场填写主机地址即可运行。
# 与 .env.example（生产基线）的差异**只在环境隔离变量**（见下方标注 [env]）。
# 环境隔离口径：带后缀的归 dev / pre，不带后缀的留给生产。
# 中间件统一部署在 21.6.51.87（earthyzinc.devcloud.woa.com），跨机部署时把各 *HOST 改为对应地址。
# 完整设计见 clarity-doc/docs/02-系统架构/10-多环境部署实践.md
# ============================================================

# ==================== 应用 ====================
JWT_SECRET_KEY=Clarity2026
# 新用户初始密码（三端统一：Java/Go/Python 创建新用户时的默认密码）
DEFAULT_PASSWORD=Clarity2026
# 种子账号（admin/root/test 等）口令不在此配置：bcrypt 固化在
# config/sql/data/sys_user.sql，明文 Clarity2026，改口令须改该 sql 的哈希

# ==================== 后端运行时 profile ====================
# 三端据此选择配置与行为，且必须在进程启动那一刻可见（Go 靠 GIN_MODE 选 config.yaml / config.prod.yaml，
# Python 靠 APP_ENV 选配置类），各端自己读 .env 的时刻晚于启动 ⇒ 由 scripts/run.py 从根 .env 注入子进程环境。
# [env] dev 用开发态 profile
SPRING_PROFILES_ACTIVE=dev
GIN_MODE=debug
APP_ENV=development
# Java 端口：prod profile 默认 80（前置代理转发），dev 与 pre 一致用 8989
# （变量名带 JAVA_ 前缀：Python 端有同名的 SERVER_PORT 配置项，勿混用）
JAVA_SERVER_PORT=8989

# ==================== CORS 跨域来源白名单（三端同名） ====================
# 逗号分隔：Java cors.allowed-origins / Go cors.allowed-origins / Python CORS_ALLOWED_ORIGINS 共读同一变量。
# Go 缺失该变量直接拒绝启动；Python 仅 prod 配置类禁止 localhost/127.0.0.1，dev 可用本机域名。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5183,http://localhost:5184,http://localhost:8081

# ==================== MySQL ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# [env] dev 库（生产 clarity / pre clarity_pre）
MYSQL_DATABASE=clarity_dev
MYSQL_USERNAME=root
MYSQL_PASSWORD=Clarity2026

# ==================== Redis ====================
# 宿主端口非默认值：办公网→DevCloud 链路代理按端口黑名单封禁 6379/9000 等默认端口
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=Clarity2026
# [env] dev 用 db1（生产 0 / pre 2）
REDIS_DATABASE=1

# ==================== MongoDB（审计日志） ====================
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
# [env] dev 库（生产 clarity / pre clarity_pre）
MONGODB_DATABASE=clarity_dev
MONGODB_USERNAME=root
MONGODB_PASSWORD=Clarity2026

# ==================== Elasticsearch（知识库向量/全文检索） ====================
ES_URL=http://127.0.0.1:9200
ES_USERNAME=elastic
ES_PASSWORD=Clarity2026
# [env] dev 索引前缀（生产留空 / pre pre_）
ES_INDEX_PREFIX=dev_

# ==================== MinIO（对象存储，API 端口 9110） ====================
MINIO_HOST=127.0.0.1
MINIO_PORT=9110
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Clarity2026
# [env] dev bucket（生产 clarity / pre clarity-pre）
MINIO_BUCKET=clarity-dev

# ==================== RabbitMQ（异步任务分发） ====================
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=Clarity2026
# [env] dev vhost（生产 %2F / pre pre）
RABBITMQ_VHOST=dev

# ==================== XXL-Job（分布式调度，admin 控制台 http://host:port/xxl-job-admin） ====================
# 三端执行器的注册地址（admin 回调用）由 scripts/run.py 注入 host.docker.internal，不在此配置；
# 手动启动单个后端时如需覆盖，导出同名环境变量 XXLJOB_EXECUTOR_IP=<本机可被容器访问的地址>
XXLJOB_HOST=127.0.0.1
XXLJOB_PORT=14980
XXLJOB_ACCESS_TOKEN=Clarity2026
# [env] java / go 执行器名后缀（生产留空 / pre -pre）
XXLJOB_ENV_SUFFIX=-dev
# [env] python 执行器名（python 端读该变量，需与本环境的 java/go 后缀一致）
XXLJOB_EXECUTOR_APP_NAME=xxl-job-executor-clarity-python-dev

# ==================== Nginx 静态文件服务（datasets 数据集 / models 算法权重托管） ====================
NGINX_STATIC_HOST=127.0.0.1
NGINX_STATIC_PORT=19000

# ==================== 监控栈（账号均为 admin） ====================
# Grafana Web 控制台（http://host:13001）
GRAFANA_ADMIN_PASSWORD=Clarity2026
# Alertmanager Basic Auth（http://host:9093，Prometheus 推送告警同用此凭证）
ALERTMANAGER_PASSWORD=Clarity2026

# ==================== 服务间调用（M2M）与 MCP 网关 ====================
# M2M API Key（需与 DB admin 用户的 API Key 一致：java/go 出站调用、MCP 网关透传均从此读取）
M2M_API_KEY=dhak_m2m_internal_python_service_key_2024
# MCP 网关共享密钥（McpGatewayClient 经 Authorization: Bearer 携带，网关侧常量时间比较校验）
MCP_GATEWAY_KEY=change-me-to-a-random-secret

# ==================== 推理服务（clarity-service，内网专用） ====================
# 编排侧（clarity-python）经 HTTP 调用外置推理服务，服务侧读同一份 .env：
# 地址与就绪口径归编排侧，模型路径/线程数/GPU 层数等推理参数归服务侧。
LOCAL_LLM_BASE_URL=http://127.0.0.1:8992
# 本地对话/向量模型是否必选依赖：默认 false（非必选）——clarity-llm 未启动不影响就绪，
# 状态仍在 /ready 中展示；本地 LLM 为必选依赖的部署显式置 true
LOCAL_LLM_REQUIRED=false
# 仅用于初始化 rerank 模型行的 max_context_tokens，须与服务侧 CTX_SIZE 一致
LOCAL_LLM_CTX_SIZE=16384
# 内置语音引擎（clarity-voice 8993）：语音引擎统一按第三方供应商注册于库内，
# 本地址仅用于 `python -m app.cli init-builtin` 初始化内置引擎供应商行的 api_base_url
VOICE_ENGINE_BASE_URL=http://127.0.0.1:8993
# 内置语音引擎是否在本部署启用：置 false 表示 ASR/TTS 全由第三方引擎提供
# （init-builtin 不初始化 local-voice 并禁用已有行）
VOICE_LOCAL_ENABLED=true
# 图像推理引擎（clarity-modal 8994）
MODAL_ENGINE_BASE_URL=http://127.0.0.1:8994
# 服务间调用密钥（Authorization: Bearer；部署级静态密钥，代表服务身份，与用户 API Key 不混用）。
# 默认 local-no-key 保证开发零摩擦，pre/prod 请覆盖为随机密钥；覆盖后须清理
# 更换后重跑 `clarity-python/.venv/bin/python -m app.cli init-builtin` 自愈：按 key_hash 判定，旧密钥行自动停用留痕，无需手动清理
INTERNAL_SERVICE_KEY=local-no-key

# ==================== AI 供应商凭据加密 ====================
# 加解密 sys_ai_provider_key 的 key_cipher（sha256(本值) 派生 AES-256 密钥）。
# 三端后端必须配置为同一值，否则彼此写入的密文互相解不开；更换本值会使历史密文全部失效。
AI_PROVIDER_KEY_ENCRYPTION_KEY=change-me-to-a-random-secret

# 容器缺少系统 CA 哈希链接时，python 默认 SSL 上下文连第三方 HTTPS/WSS（如火山语音）会
# CERTIFICATE_VERIFY_FAILED（httpx 用 certifi 不受影响，websockets 受影响）。按需指向系统 CA bundle：
# SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
