{
  "name": "dehaze-taro",
  "version": "1.0.0",
  "private": true,
  "description": "基于 React + TypeScript + Taro + Webpack 技术栈的深度学习图像去雾系统移动端，包含小程序和H5界面",
  "packageManager": "pnpm@10.18.0",
  "templateInfo": {
    "name": "context",
    "typescript": true,
    "css": "Less",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:harmory": "taro build --type harmony_cpp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:harmory": "npm run build:harmory -- --watch",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint && pnpm run lint:prettier",
    "lint:eslint": "eslint --fix ./src",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,json,jsx,ts,tsx,css,less,html,md}\"",
    "lint:stylelint": "stylelint \"**/*.{css,less}\" --fix",
    "type-check": "tsc --noEmit"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@taroify/core": "^0.9.0",
    "@taroify/icons": "^0.9.0",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-http": "4.2.1",
    "@tarojs/plugin-platform-alipay": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-jd": "4.2.1",
    "@tarojs/plugin-platform-qq": "4.2.1",
    "@tarojs/plugin-platform-swan": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "axios": "^1.18.1",
    "dehaze-sdk-js": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-react": "^7.27.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-platform-harmony-cpp": "4.2.1",
    "@tarojs/plugin-platform-harmony-ets": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/jest": "^30.0.0",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^24.7.2",
    "@types/react": "^18.3.26",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "4.2.1",
    "compression-webpack-plugin": "^11.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^30.2.0",
    "jsdom": "^27.0.1",
    "less": "^4.4.2",
    "postcss": "^8.5.6",
    "postcss-less": "^6.0.0",
    "prettier": "^3.6.2",
    "react-refresh": "^0.14.2",
    "sharp": "^0.35.3",
    "stylelint": "^16.25.0",
    "stylelint-config-recess-order": "^7.3.0",
    "stylelint-config-standard": "^39.0.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "webpack": "5.91.0",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
