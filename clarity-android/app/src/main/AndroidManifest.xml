            android:theme="@style/Theme.Clarity" />

        <!-- 字典数据管理 Activity -->
        <activity
            android:name=".ui.system.DictItemListActivity"
            android:exported="false"
            android:theme="@style/Theme.Clarity" />

        <!-- 任务管理 Activity -->
        <activity
