            android:exported="false"
            android:theme="@style/Theme.Clarity" />

        <!-- 文件管理 Activity -->
        <activity
            android:name=".ui.file.FileListActivity"
            android:exported="false"
            android:theme="@style/Theme.Clarity" />

        <!-- 菜单管理 Activity -->
        <activity
            android:name=".ui.system.MenuListActivity"
            android:exported="false"
            android:theme="@style/Theme.Clarity" />

        <!-- 字典类型管理 Activity -->
        <activity
            android:name=".ui.system.DictTypeListActivity"
