        <activity
            android:name=".ui.personal.FeedbackActivity"
            android:exported="false"
            android:theme="@style/Theme.Clarity" />

        <activity
            android:name=".ui.personal.FavoritesActivity"
            android:exported="false"
            android:theme="@style/Theme.Clarity" />

        <activity
            android:name=".ui.personal.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Clarity" />

        <activity
