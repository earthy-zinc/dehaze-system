# 统一入口：在仓库根执行 lint-staged，由 lint-staged.config.mjs 按包分派。
# 不在根直接调 eslint/ruff：各包的配置都在包内，必须 cd 进包目录才解析得到。
if [ ! -x ./clarity-front-vue/node_modules/.bin/lint-staged ]; then
  echo "husky: 未找到 lint-staged，请先在仓库根执行 pnpm install -r" >&2
  exit 1
fi

exec ./clarity-front-vue/node_modules/.bin/lint-staged --config lint-staged.config.mjs
