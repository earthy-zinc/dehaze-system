{
  "_comment": "clarity 开发环境统一管理配置。setup-toolchain.ps1(Windows) 与 setup-toolchain-linux.sh(WSL/Linux) 共用。install 段通用可反复跑；legacy 段仅迁移旧环境用，全新机器留空。",

  "runtimes": {
    "node": "24",
    "go": "1.25",
    "java": "temurin-21"
  },

  "python": {
    "default": "3.13"
  },

  "globalNpmPackages": {
    "_comment": "全局 npm 包只装在这个 node 版本下（各平台共用），避免每个 node 版本重复安装。",
    "nodeVersion": "24",
    "packages": [
      "@tencent-ai/codebuddy-code",
      "@tencent/panshi-api-doc-mcp",
      "@tencent/panshi-dim-mcp",
      "@playwright/cli",
      "agent-browser",
      "chrome-devtools-mcp",
      "pm2",
      "pnpm",
      "whistle",
      "tsx",
      "yarn"
    ]
  },

  "mirrors": {
    "overrideExisting": false,
    "_overrideComment": "false = 不覆盖机器已有的 GOPROXY/GOSUMDB、npm registry、pip index-url（内网机器必须为 false，否则会顶掉内网源）。true 时才写入下面这些公网镜像。",
    "scoopRepo": "https://gitee.com/scoop-installer/scoop",
    "bucketBase": "https://gitee.com/scoop-installer",
    "proxyBucket": "https://gitee.com/wlzwme/scoop-proxy-cn",
    "npmRegistry": "https://registry.npmmirror.com",
    "pipIndex": "https://pypi.tuna.tsinghua.edu.cn/simple",
    "goProxy": "https://goproxy.cn,direct",
    "goSumDb": "sum.golang.google.cn",
    "miseNodeMirror": "https://npmmirror.com/mirrors/node/",
    "uvPythonMirror": "",
    "mavenMirror": "https://maven.aliyun.com/repository/public",
    "aptMirror": "https://mirrors.tuna.tsinghua.edu.cn/ubuntu"
  },

  "windows": {
    "buckets": ["main", "extras", "versions", "java"],
    "useProxyBucket": true,
    "userApps": ["aria2", "pwsh"],
    "pnpmGlobals": ["yarn", "@ant-design/pro-cli", "node-stdio"],
    "globalApps": [
      "maven", "gradle", "protobuf", "pandoc", "make", "helm", "uv",
      "jq", "yq", "ripgrep", "fd", "fzf", "bat", "delta", "zoxide",
      "hyperfine", "tree", "7zip", "wget", "just", "gh"
    ]
  },

  "linux": {
    "aptSourceFile": "/etc/apt/sources.list.d/ubuntu.sources",
    "aptPackages": [
      "build-essential", "curl", "wget", "git", "unzip", "jq", "aria2",
      "ripgrep", "fd-find", "bat", "fzf", "tree", "htop", "ca-certificates"
    ],
    "_dnfComment": "dnf（TencentOS/CentOS/Rocky 等 RHEL 系）等价包名；不做换源，沿用机器现有内网源。",
    "dnfPackages": [
      "gcc", "gcc-c++", "make", "curl", "wget", "git", "unzip", "jq", "aria2",
      "ripgrep", "fd-find", "bat", "fzf", "tree", "htop", "ca-certificates"
    ],
    "_extraComment": "额外运行时版本，只 mise install 不改变 .runtimes 里的全局默认版本。Linux x64 下 node 14 有官方预编译包，无需架构覆盖。",
    "extraVersions": {
      "node": ["14.17.0", "20"],
      "java": ["temurin-17"]
    }
  },

  "macos": {
    "_comment": "brew 安装 mise；Java 全部交给 mise 管理，不复用 brew 已装的 openjdk。",
    "extraVersions": {
      "_comment": "多项目需要的额外运行时版本，只 mise install 不改变 .runtimes 里的全局默认版本。",
      "node": ["20"],
      "nodeArchX64": ["14.17.0"],
      "java": ["temurin-17"],
      "_nodeArchX64Comment": "node 14 等旧版本官方没有 darwin-arm64 预编译包，源码编译会因新版 Xcode SDK 失败；改用 MISE_ARCH=x64 下载 Intel 版，经 Rosetta 运行，装好后可直接 mise exec node@14 使用。"
    },
    "legacy": {
      "_comment": "迁移前旧装清理，cleanup 步使用。",
      "brewRemove": ["openjdk@17", "openjdk@21", "openjdk@25"],
      "manualDirs": ["/usr/local/go"],
      "sudoDirs": ["/usr/local/go"],
      "sudoSymlinks": [
        "/Library/Java/JavaVirtualMachines/openjdk-17.jdk",
        "/Library/Java/JavaVirtualMachines/openjdk-21.jdk",
        "/Library/Java/JavaVirtualMachines/openjdk-25.jdk"
      ],
      "shellStripPatterns": [
        "NVM_DIR", "nvm.sh", "bash_completion.*nvm",
        "GOENV_ROOT", "goenv init",
        "JAVA_HOME=/opt/homebrew/opt/openjdk"
      ]
    }
  },

  "legacy": {
    "_comment": "迁移前旧环境专用，Cleanup 步使用。全新机器把下面各项留空即可。",
    "windows": {
      "choco": ["kubernetes-helm", "python", "python3", "python313"],
      "machinePathFragments": [
        "Oracle\\Java\\javapath",
        "Python313",
        "Java\\jdk-17\\bin",
        "Program Files\\Go\\bin",
        "apache-maven",
        "Gradle\\gradle",
        "protobuf-31.1",
        "Pandoc",
        "GnuWin32\\bin",
        "Programs\\nodejs"
      ],
      "userPathFragments": [
        "Programs\\nodejs",
        "AppData\\Local\\nvm"
      ],
      "envVars": ["JAVA_HOME", "GOROOT", "NVM_HOME", "NVM_SYMLINK"],
      "dirs": [
        "C:\\Program Files\\Go",
        "C:\\Program Files\\Java",
        "C:\\Python313",
        "C:\\Programs\\apache-maven-3.9.5",
        "C:\\Program Files\\Gradle\\gradle-8.8",
        "C:\\Programs\\protobuf-31.1",
        "C:\\Program Files\\Pandoc",
        "C:\\Program Files (x86)\\GnuWin32",
        "C:\\Users\\earthyzinc\\AppData\\Local\\nvm",
        "C:\\Users\\earthyzinc\\AppData\\Roaming\\npm",
        "C:\\Users\\earthyzinc\\miniconda3"
      ],
      "links": [
        "C:\\Programs\\nodejs"
      ],
      "msiProductCodes": [
        "{61C3B7D2-33F9-5107-9F20-AB1A7C8B5C2A}",
        "{64A3A4F4-B792-11D6-A78A-00B0D0180341}",
        "{71324AE4-039E-4CA4-87B4-2F64180391F0}",
        "{4A03706F-666A-4037-7777-5F2748764D10}",
        "{CB1669C4-DF67-577C-8DC1-B1C5628FEC98}",
        "{EAAE4648-306F-5360-8CAA-C93D6F5C2298}",
        "{BF44F985-A720-4EB9-8B4B-6C2F76A30CDB}",
        "{366AC84A-6A67-4F5B-8B30-8948359615D8}"
      ],
      "registryKeys": [
        "HKLM:\\SOFTWARE\\JavaSoft",
        "HKLM:\\SOFTWARE\\WOW6432Node\\JavaSoft"
      ]
    },
    "linux": {
      "_comment": "勿在此移除 openjdk/default-jre：CUDA 的 cuda-visual-tools 依赖 JRE，会级联卸载整条 CUDA 工具链（已踩过）。路径取三台远程机（earthy-dev/pre/pm，均为 root）旧装的并集，不存在的项自动跳过。`~/` 开头会展开成 $HOME。",
      "aptRemove": ["nodejs", "npm"],
      "manualFiles": ["~/.local/bin/go"],
      "manualDirs": [
        "/usr/local/go",
        "~/.nvm",
        "/usr/local/lib/.nvm",
        "~/.goenv",
        "/usr/local/java/jdk17",
        "/usr/local/java/jdk21",
        "/usr/local/java/jdk25",
        "/usr/local/java/jdk-17.0.9+9",
        "/usr/local/java/jdk-21.0.12.1+1",
        "/usr/local/java/jdk-25.0.4.1+1"
      ],
      "shellStripPatterns": [
        "/usr/local/go/bin", "NVM_DIR", "nvm.sh", "GOENV_ROOT", "goenv init",
        "JAVA_HOME=/usr/local/java"
      ]
    }
  }
}
