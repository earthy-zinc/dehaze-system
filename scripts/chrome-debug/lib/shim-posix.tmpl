#!/bin/sh
{{daemonGuard}}
if [ ! -x "{{realToolPath}}" ]; then
  echo "{{tool}} 不存在，请重新执行 chrome-debug install：{{realToolPath}}" >&2
  exit 127
fi

if ! curl -sf --max-time 1 "{{cdpUrl}}/json/version" >/dev/null 2>&1; then
  if [ -x "{{chromePath}}" ]; then
    mkdir -p "{{userDir}}"
    nohup "{{chromePath}}" \
      --remote-debugging-port={{cdpPort}} \
      --remote-debugging-address={{loopback}} \
      --user-data-dir="{{userDir}}" \
      --no-first-run --no-default-browser-check {{extraArgs}} \
      >/dev/null 2>&1 &
    i=0
    while [ "$i" -lt {{startupPolls}} ]; do
      curl -sf --max-time 1 "{{cdpUrl}}/json/version" >/dev/null 2>&1 && break
      sleep {{startupPollSeconds}}
      i=$((i + 1))
    done
  fi
fi

exec "{{realToolPath}}" "$@"
