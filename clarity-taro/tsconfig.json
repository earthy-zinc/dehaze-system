{
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "target": "es2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "removeComments": false,
    "preserveConstEnums": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "lib",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    // SDK 源码直连后公共源目录是仓库根（clarity-taro 的上一级），必须显式声明 rootDir，
    // 否则 TS 会报「common source directory is '..'」；本仓只用 tsc --noEmit 检查，不实际 emit
    "rootDir": "..",
    "paths": {
      "@/*": ["./src/*"],
      "clarity-sdk-js": ["../clarity-sdk-js/index.ts"]
    },
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "typeRoots": ["node_modules/@types"],
    "skipLibCheck": true
  },
  "include": ["./src", "./types"],
  "compileOnSave": false
}
