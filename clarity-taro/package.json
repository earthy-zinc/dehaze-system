    "react-native-webview": "~13.6.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-react": "^7.27.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-platform-harmony-cpp": "4.2.1",
    "@tarojs/plugin-platform-harmony-ets": "4.2.1",
    "@tarojs/rn-runner": "4.2.1",
    "@tarojs/rn-supporter": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/jest": "^30.0.0",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^24.7.2",
    "@types/react": "^18.3.26",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "4.2.1",
    "compression-webpack-plugin": "^11.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^30.2.0",
    "jsdom": "^27.0.1",
    "less": "^4.4.2",
    "postcss": "^8.5.6",
    "postcss-less": "^6.0.0",
    "prettier": "^3.6.2",
    "react-refresh": "^0.14.2",
    "sharp": "^0.35.3",
    "stylelint": "^16.25.0",
    "stylelint-config-recess-order": "^7.3.0",
    "stylelint-config-standard": "^39.0.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "webpack": "5.91.0",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
