{
  "name": "clarity-taro",
  "version": "1.0.0",
  "private": true,
  "description": "基于 React + TypeScript + Taro + Webpack 技术栈的澄莹移动端应用，包含小程序和 H5 界面",
  "packageManager": "pnpm@10.18.0",
  "templateInfo": {
    "name": "context",
    "typescript": true,
    "css": "Less",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:harmory": "taro build --type harmony_cpp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:harmory": "npm run build:harmory -- --watch",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint && pnpm run lint:prettier && pnpm run type-check",
    "lint:eslint": "eslint --fix ./src",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,json,jsx,ts,tsx,css,less,html,md}\"",
    "lint:stylelint": "stylelint \"**/*.{css,less}\" --fix",
    "type-check": "tsc --noEmit"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "earthyzinc",
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@bam.tech/react-native-image-resizer": "^3.0.11",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "11.1.0",
    "@react-native-community/slider": "~4.4.2",
    "@react-native-masked-view/masked-view": "~0.3.2",
    "@react-native-picker/picker": "~2.6.1",
    "@react-native/babel-preset": "^0.73.21",
    "@react-native/metro-config": "^0.73.5",
    "@taroify/core": "^0.9.0",
    "@taroify/icons": "^0.9.0",
    "@tarojs/components": "4.2.1",
    "@tarojs/components-rn": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-http": "4.2.1",
    "@tarojs/plugin-platform-alipay": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-jd": "4.2.1",
    "@tarojs/plugin-platform-qq": "4.2.1",
    "@tarojs/plugin-platform-swan": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/runtime-rn": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@tarojs/taro-rn": "4.2.1",
    "axios": "^1.18.1",
    "clarity-sdk-js": "workspace:*",
    "expo": "~50.0.21",
    "expo-av": "~13.10.6",
    "expo-barcode-scanner": "~12.9.3",
    "expo-brightness": "~11.8.0",
    "expo-camera": "~14.1.3",
    "expo-file-system": "~16.0.9",
    "expo-image-picker": "~14.7.1",
    "expo-keep-awake": "~12.8.2",
    "expo-location": "~16.5.5",
    "expo-sensors": "~12.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.73.11",
    "react-native-device-info": "^14.1.1",
    "react-native-gesture-handler": "~2.14.1",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-pager-view": "~6.2.3",
    "react-native-root-siblings": "^5.0.1",
