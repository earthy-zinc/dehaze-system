{
  "extends": "./pyright.base.json",
  "venvPath": "dehaze-python",
  "venv": ".venv",
  "include": [
    "dehaze-python/app",
    "dehaze-python/tests",
    "dehaze-mcp-gateway",
  ],
  "ignore": [
    "dehaze-python/logs",
    "dehaze-service/dehaze-modal/algorithm",
    "dehaze-service/dehaze-llm/app",
    "dehaze-service/dehaze-llm/tests",
    "dehaze-service/dehaze-voice/app",
    "dehaze-service/dehaze-voice/tests",
    "dehaze-service/dehaze-modal/app",
    "dehaze-service/dehaze-modal/tests"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "**/.venv",
    "**/dehaze-algorithm",
    "**/dehaze-go",
    "**/dehaze-java",
    "**/dehaze-android",
    "**/dehaze_flutter",
    "**/dehaze-react-native",
    "**/dehaze-taro",
    "**/dehaze-uniapp",
    "**/dehaze-front-vue",
    "**/dehaze-front-react",
    "**/dehaze-sdk-js",
    "**/scripts",
    "**/config"
  ],
  "extraPaths": [
    "dehaze-python"
  ],
  "executionEnvironments": [
    {
      "root": "dehaze-mcp-gateway/tests",
      "extraPaths": [
        "dehaze-python",
        "dehaze-mcp-gateway"
      ]
    },
    {
      "root": "dehaze-service/dehaze-llm",
      "extraPaths": [
        "dehaze-service/dehaze-llm"
      ]
    },
    {
      "root": "dehaze-service/dehaze-voice",
      "extraPaths": [
        "dehaze-service/dehaze-voice"
      ]
    },
    {
      "root": "dehaze-service/dehaze-modal",
      "extraPaths": [
        "dehaze-service/dehaze-modal"
      ]
    }
  ]
}
