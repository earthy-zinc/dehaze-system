{
  "extends": "./pyright.base.json",
  "venvPath": "clarity-python",
  "venv": ".venv",
  "include": [
    "clarity-python/app",
    "clarity-python/tests",
    "clarity-mcp-gateway",
  ],
  "ignore": [
    "clarity-python/logs",
    "clarity-service/clarity-modal/algorithm",
    "clarity-service/clarity-llm/app",
    "clarity-service/clarity-llm/tests",
    "clarity-service/clarity-voice/app",
    "clarity-service/clarity-voice/tests",
    "clarity-service/clarity-modal/app",
    "clarity-service/clarity-modal/tests"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "**/.venv",
    "**/clarity-algorithm",
    "**/clarity-go",
    "**/clarity-java",
    "**/clarity-android",
    "**/clarity_flutter",
    "**/clarity-react-native",
    "**/clarity-taro",
    "**/clarity-uniapp",
    "**/clarity-front-vue",
    "**/clarity-front-react",
    "**/clarity-sdk-js",
    "**/scripts",
    "**/config"
  ],
  "extraPaths": [
    "clarity-python"
  ],
  "executionEnvironments": [
    {
      "root": "clarity-mcp-gateway/tests",
      "extraPaths": [
        "clarity-python",
        "clarity-mcp-gateway"
      ]
    },
    {
      "root": "clarity-service/clarity-llm",
      "extraPaths": [
        "clarity-service/clarity-llm"
      ]
    },
    {
      "root": "clarity-service/clarity-voice",
      "extraPaths": [
        "clarity-service/clarity-voice"
      ]
    },
    {
      "root": "clarity-service/clarity-modal",
      "extraPaths": [
        "clarity-service/clarity-modal"
      ]
    }
  ]
}
