<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 存储权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".DehazeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dehaze"
        tools:targetApi="31">
        <!-- 主Activity作为启动Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dehaze">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- 对比Activity -->
        <activity
            android:name=".ui.compare.CompareActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 评估Activity -->
        <activity
            android:name=".ui.evaluation.EvaluationActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 展示Activity -->
        <activity
            android:name=".ui.presentation.PresentationActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 算法列表 Activity -->
        <activity
            android:name=".ui.algorithm.AlgorithmListActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 算法详情 Activity -->
        <activity
            android:name=".ui.algorithm.AlgorithmDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 算法选择 Activity -->
        <activity
            android:name=".ui.algorithm_select.AlgorithmSelectActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 部门管理 Activity -->
        <activity
            android:name=".ui.system.DeptListActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 角色管理 Activity -->
        <activity
            android:name=".ui.system.RoleListActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 用户管理 Activity -->
        <activity
            android:name=".ui.system.UserListActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 文件管理 Activity -->
        <activity
            android:name=".ui.file.FileListActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 菜单管理 Activity -->
        <activity
            android:name=".ui.system.MenuListActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 字典类型管理 Activity -->
        <activity
            android:name=".ui.system.DictTypeListActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 字典数据管理 Activity -->
        <activity
            android:name=".ui.system.DictItemListActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 任务管理 Activity -->
        <activity
            android:name=".ui.task.TaskListActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />

        <!-- 图像输入历史 Activity -->
        <activity
            android:name=".ui.input.InputHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Dehaze" />
    </application>

</manifest>