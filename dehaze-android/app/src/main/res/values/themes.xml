<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Material3, NoActionBar for toolbar customization) -->
    <style name="Base.Theme.Dehaze" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color (蓝 #3B82F6) -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background & surface -->
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Error -->
        <item name="colorError">@color/color_error</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Application theme (used by Manifest) -->
    <style name="Theme.Dehaze" parent="Base.Theme.Dehaze">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
    </style>

    <!-- Login theme (fullscreen, no action bar, gradient background) -->
    <style name="Theme.Dehaze.Login" parent="Theme.Dehaze">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>
