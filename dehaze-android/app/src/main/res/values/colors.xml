<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基本颜色（保留兼容） -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ===== 品牌色系（对齐 UI-UX 设计规范 02-UI-UX设计规范.md） ===== -->
    <!-- 主色（品牌蓝）#3B82F6 -->
    <color name="brand_primary">#FF3B82F6</color>
    <!-- 渐变主色终点 #6366F1 -->
    <color name="brand_primary_dark">#FF6366F1</color>
    <!-- 辅助蓝 #4285F4 -->
    <color name="brand_secondary">#FF4285F4</color>
    <!-- 品牌渐变起始色 -->
    <color name="brand_gradient_start">#FF3B82F6</color>
    <!-- 品牌渐变结束色 -->
    <color name="brand_gradient_end">#FF6366F1</color>

    <!-- ===== 功能色 ===== -->
    <color name="color_success">#FF4CAF50</color>
    <color name="color_warning">#FFFF9800</color>
    <color name="color_error">#FFF44336</color>
    <color name="color_info">#FF2196F3</color>

    <!-- ===== 中性色（灰度色阶） ===== -->
    <color name="text_primary">#FF1F2937</color>
    <color name="text_regular">#FF4B5563</color>
    <color name="text_secondary">#FF6B7280</color>
    <color name="text_placeholder">#FFA8ABB2</color>
    <color name="bg_page">#FFF5F7FA</color>
    <color name="bg_card">#FFFFFFFF</color>
    <color name="border_light">#FFE5E7EB</color>

    <!-- ===== 指标卡片渐变（#667EEA → #764BA2） ===== -->
    <color name="metric_gradient_start">#FF667EEA</color>
    <color name="metric_gradient_end">#FF764BA2</color>

    <!-- ===== 兼容旧引用（统一指向品牌色，避免历史脏色彩） ===== -->
    <color name="colorPrimary">@color/brand_primary</color>
    <color name="colorPrimaryDark">@color/brand_primary_dark</color>
    <color name="colorPrimaryLight">#FFDBEAFE</color>
    <color name="colorAccent">@color/brand_primary</color>
    <color name="colorError">@color/color_error</color>
</resources>
