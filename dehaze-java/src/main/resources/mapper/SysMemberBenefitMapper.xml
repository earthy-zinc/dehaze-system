<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pei.dehaze.mapper.SysMemberBenefitMapper">

    <!-- ==================== 原生SQL：绕过@TableLogic软删过滤 ==================== -->

    <!-- 按等级编码查询会员权益数（含已软删行） -->
    <select id="countByLevelCodeAll" resultType="java.lang.Long">
        SELECT COUNT(*) FROM sys_member_benefit WHERE level_code = #{levelCode}
    </select>

    <!-- 按等级编码查询会员权益数（排除指定ID，含已软删行） -->
    <select id="countByLevelCodeAllExcluding" resultType="java.lang.Long">
        SELECT COUNT(*) FROM sys_member_benefit WHERE level_code = #{levelCode} AND id != #{excludeId}
    </select>

</mapper>
