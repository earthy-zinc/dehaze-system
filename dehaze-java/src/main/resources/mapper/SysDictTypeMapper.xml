<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pei.dehaze.mapper.SysDictTypeMapper">

    <resultMap id="BaseResultMap" type="com.pei.dehaze.model.entity.SysDictType">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="code" column="code" jdbcType="VARCHAR"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="remark" column="remark" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- ==================== 原生SQL：绕过@TableLogic软删过滤 ==================== -->

    <!-- 按编码查询字典类型数（含已软删行） -->
    <select id="countByCodeAll" resultType="java.lang.Long">
        SELECT COUNT(*) FROM sys_dict_type WHERE code = #{code}
    </select>

    <!-- 按编码查询字典类型数（排除指定ID，含已软删行） -->
    <select id="countByCodeAllExcluding" resultType="java.lang.Long">
        SELECT COUNT(*) FROM sys_dict_type WHERE code = #{code} AND id != #{excludeId}
    </select>
</mapper>
