<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pei.dehaze.mapper.SysDictMapper">

    <!-- ==================== 原生SQL：绕过@TableLogic软删过滤 ==================== -->

    <!-- 按type_code+value查询字典项数（含已软删行） -->
    <select id="countByTypeCodeAndValueAll" resultType="java.lang.Long">
        SELECT COUNT(*) FROM sys_dict
        WHERE type_code = #{typeCode} AND value = #{value}
    </select>

    <!-- 按type_code+value查询字典项数（排除指定ID，含已软删行） -->
    <select id="countByTypeCodeAndValueAllExcluding" resultType="java.lang.Long">
        SELECT COUNT(*) FROM sys_dict
        WHERE type_code = #{typeCode} AND value = #{value} AND id != #{excludeId}
    </select>

</mapper>
