# ============================================================
# Dehaze 环境变量模板（复制为 .env 后按环境填写）
#
# 按基础设施分区，各服务凭证独立配置，无全局统一密码。
# 三端后端（dehaze-java / dehaze-go / dehaze-python）通过各自
# 配置加载机制读取本文件：spring-dotenv / godotenv+ExpandEnv /
# pydantic-settings。修改后需重启对应服务生效。
# ============================================================

# ==================== 应用 ====================
JWT_SECRET_KEY=Dehaze2026
# 新用户初始密码（三端统一：Java/Go/Python 创建新用户时的默认密码）
DEFAULT_PASSWORD=Dehaze2026
# 种子账号 admin 的登录密码（bcrypt 固化在 config/sql/data/sys_user.sql；
# 此变量仅供集成测试/联调工具登录使用，修改它不会改变账号真实密码）
ADMIN_PASSWORD=Dehaze2026

# ==================== MySQL ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dehaze
MYSQL_USERNAME=root
MYSQL_PASSWORD=Dehaze2026

# ==================== Redis ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=Dehaze2026
REDIS_DATABASE=0

# ==================== MongoDB（审计日志） ====================
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=dehaze
MONGODB_USERNAME=root
MONGODB_PASSWORD=Dehaze2026

# ==================== Elasticsearch（知识库向量/全文检索） ====================
ES_URL=http://127.0.0.1:9200
ES_USERNAME=elastic
ES_PASSWORD=Dehaze2026

# ==================== MinIO（对象存储，API 端口 9110） ====================
MINIO_HOST=127.0.0.1
MINIO_PORT=9110
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Dehaze2026
MINIO_BUCKET=dehaze

# ==================== RabbitMQ（异步任务分发） ====================
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=Dehaze2026

# ==================== XXL-Job（分布式调度，admin 控制台 http://host:port/xxl-job-admin） ====================
XXLJOB_HOST=127.0.0.1
XXLJOB_PORT=14980
XXLJOB_ACCESS_TOKEN=Dehaze2026

# ==================== Nginx 静态文件服务（datasets 数据集 / models 算法权重托管） ====================
NGINX_STATIC_HOST=127.0.0.1
NGINX_STATIC_PORT=9000

# ==================== 监控栈（账号均为 admin） ====================
# Grafana Web 控制台（http://host:13001）
GRAFANA_ADMIN_PASSWORD=Dehaze2026
# Alertmanager Basic Auth（http://host:9093，Prometheus 推送告警同用此凭证）
ALERTMANAGER_PASSWORD=Dehaze2026
