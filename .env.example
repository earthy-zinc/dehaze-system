# ============================================================
# Dehaze 环境变量模板（复制为 .env 后按环境填写）
#
# 按基础设施分区，各服务凭证独立配置，无全局统一密码。
# 三端后端（dehaze-java / dehaze-go / dehaze-python）通过各自
# 配置加载机制读取本文件：spring-dotenv / godotenv+ExpandEnv /
# pydantic-settings。修改后需重启对应服务生效。
# ============================================================

# ==================== 应用 ====================
JWT_SECRET_KEY=Dehaze2026
# 新用户初始密码（三端统一：Java/Go/Python 创建新用户时的默认密码）
DEFAULT_PASSWORD=Dehaze2026
# 种子账号（admin/root/test 等）口令不在此配置：bcrypt 固化在
# config/sql/data/sys_user.sql，明文 Dehaze2026，改口令须改该 sql 的哈希

# 环境隔离变量（本文件为生产基线：不带后缀/前缀的名称留给生产）：
#   命名空间   生产             dev               pre
#   MySQL      dehaze           dehaze_dev        dehaze_pre
#   MongoDB    dehaze           dehaze_dev        dehaze_pre
#   Redis db   0                1                 2
#   MinIO      dehaze           dehaze-dev        dehaze-pre
#   MQ vhost   %2F              dev               pre
#   ES 前缀    （空）            dev_              pre_
#   XXL 后缀   （空）            -dev              -pre
#   后端 profile prod·release·production  dev·debug·development  prod·release·production（另加 HTTP/限流等覆盖）
# 完整可复制的环境模板见 .env.dev.example / .env.pre.example

# ==================== 后端运行时 profile ====================
# 三端据此选择配置与行为，且必须在进程启动那一刻可见（Go 靠 GIN_MODE 选 config.yaml / config.prod.yaml，
# Python 靠 APP_ENV 选配置类），各端自己读 .env 的时刻晚于启动 ⇒ 由 scripts/run.py 从根 .env 注入子进程环境。
# [env] 本文件为生产取值；dev 用 dev·debug·development，pre 复用 prod 但需覆盖若干项（见 .env.pre.example）
SPRING_PROFILES_ACTIVE=prod
GIN_MODE=release
APP_ENV=production
# Java 端口：生产由前置代理转发到 80；pre 与 dev 用 8989 覆盖
# （变量名带 JAVA_ 前缀：Python 端有同名的 SERVER_PORT 配置项，勿混用）
JAVA_SERVER_PORT=80

# ==================== CORS 跨域来源白名单（三端同名） ====================
# 逗号分隔：Java cors.allowed-origins / Go cors.allowed-origins / Python CORS_ALLOWED_ORIGINS 共读同一变量。
# 生产必须填正式域名：Python 的 prod 配置类禁止 localhost/127.0.0.1（缺失或含 localhost 会启动失败），
# Go 缺失该变量同样拒绝启动。生产前端经前置代理与后端同源，此白名单只约束浏览器直连后端的场景。
CORS_ALLOWED_ORIGINS=https://<改为本生产的正式前端域名>

# ==================== MySQL ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dehaze
MYSQL_USERNAME=root
MYSQL_PASSWORD=Dehaze2026

# ==================== Redis ====================
# 宿主端口非默认值：办公网→DevCloud 链路代理按端口黑名单封禁 6379/9000 等默认端口
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=Dehaze2026
# 环境隔离用 db 编号表达：生产 0 / dev 1 / pre 2
REDIS_DATABASE=0

# ==================== MongoDB（审计日志） ====================
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=dehaze
MONGODB_USERNAME=root
MONGODB_PASSWORD=Dehaze2026

# ==================== Elasticsearch（知识库向量/全文检索） ====================
ES_URL=http://127.0.0.1:9200
ES_USERNAME=elastic
ES_PASSWORD=Dehaze2026
# 索引名前缀：生产留空 / dev dev_ / pre pre_
ES_INDEX_PREFIX=

# ==================== MinIO（对象存储，API 端口 9110） ====================
MINIO_HOST=127.0.0.1
MINIO_PORT=9110
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Dehaze2026
MINIO_BUCKET=dehaze

# ==================== RabbitMQ（异步任务分发） ====================
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=Dehaze2026
# vhost（amqp URL 路径部分）：%2F 为默认 vhost（生产）/ dev / pre
RABBITMQ_VHOST=%2F

# ==================== XXL-Job（分布式调度，admin 控制台 http://host:port/xxl-job-admin） ====================
# 三端执行器的注册地址（admin 回调用）由 scripts/run.py 注入 host.docker.internal，不在此配置；
# 手动启动单个后端时如需覆盖，导出同名环境变量 XXLJOB_EXECUTOR_IP=<本机可被容器访问的地址>
XXLJOB_HOST=127.0.0.1
XXLJOB_PORT=14980
XXLJOB_ACCESS_TOKEN=Dehaze2026
# 执行器名环境后缀（java/go 拼接用）：生产留空 / dev -dev / pre -pre
XXLJOB_ENV_SUFFIX=
# python 执行器名（已可整体覆盖，按环境改后缀）
XXLJOB_EXECUTOR_APP_NAME=xxl-job-executor-dehaze-python

# ==================== Nginx 静态文件服务（datasets 数据集 / models 算法权重托管） ====================
NGINX_STATIC_HOST=127.0.0.1
NGINX_STATIC_PORT=19000

# ==================== 监控栈（账号均为 admin） ====================
# Grafana Web 控制台（http://host:13001）
GRAFANA_ADMIN_PASSWORD=Dehaze2026
# Alertmanager Basic Auth（http://host:9093，Prometheus 推送告警同用此凭证）
ALERTMANAGER_PASSWORD=Dehaze2026

# ==================== 服务间调用（M2M）与 MCP 网关 ====================
# M2M API Key（需与 DB admin 用户的 API Key 一致：java/go 出站调用、MCP 网关透传均从此读取）
M2M_API_KEY=dhak_m2m_internal_python_service_key_2024
# MCP 网关共享密钥（McpGatewayClient 经 Authorization: Bearer 携带，网关侧常量时间比较校验）
MCP_GATEWAY_KEY=change-me-to-a-random-secret

# ==================== 推理服务（dehaze-service，内网专用） ====================
# 编排侧（dehaze-python）经 HTTP 调用外置推理服务，服务侧读同一份 .env：
# 地址与就绪口径归编排侧，模型路径/线程数/GPU 层数等推理参数归服务侧。
LOCAL_LLM_BASE_URL=http://127.0.0.1:8992
# 本地对话/向量模型是否必选依赖：默认 false（非必选）——dehaze-llm 未启动不影响就绪，
# 状态仍在 /ready 中展示；本地 LLM 为必选依赖的部署显式置 true
LOCAL_LLM_REQUIRED=false
# 仅用于初始化 rerank 模型行的 max_context_tokens，须与服务侧 CTX_SIZE 一致
LOCAL_LLM_CTX_SIZE=16384
# 内置语音引擎（dehaze-voice 8993）：语音引擎统一按第三方供应商注册于库内，
# 本地址仅用于 `python -m app.cli init-builtin` 初始化内置引擎供应商行的 api_base_url
VOICE_ENGINE_BASE_URL=http://127.0.0.1:8993
# 内置语音引擎是否在本部署启用：置 false 表示 ASR/TTS 全由第三方引擎提供
# （init-builtin 不初始化 local-voice 并禁用已有行）
VOICE_LOCAL_ENABLED=true
# 图像推理引擎（dehaze-modal 8994）
MODAL_ENGINE_BASE_URL=http://127.0.0.1:8994
# 服务间调用密钥（Authorization: Bearer；部署级静态密钥，代表服务身份，与用户 API Key 不混用）。
# 生产必须覆盖为随机密钥；更换后重跑 `dehaze-python/.venv/bin/python -m app.cli init-builtin` 自愈：
# 按 key_hash 判定，旧密钥行自动停用留痕，无需手动清理
INTERNAL_SERVICE_KEY=change-me-to-a-random-secret

# ==================== AI 供应商凭据加密 ====================
# 加解密 sys_ai_provider_key 的 key_cipher（sha256(本值) 派生 AES-256 密钥）。
# 三端后端必须配置为同一值，否则彼此写入的密文互相解不开；更换本值会使历史密文全部失效。
AI_PROVIDER_KEY_ENCRYPTION_KEY=change-me-to-a-random-secret

# 容器缺少系统 CA 哈希链接时，python 默认 SSL 上下文连第三方 HTTPS/WSS（如火山语音）会
# CERTIFICATE_VERIFY_FAILED（httpx 用 certifi 不受影响，websockets 受影响）。按需指向系统 CA bundle：
# SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
