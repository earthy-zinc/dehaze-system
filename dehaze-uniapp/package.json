{
  "name": "uni-preset-vue",
  "version": "0.0.0",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev:h5": "uni --host",
    "dev:h5:ssr": "uni --ssr",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:mp-baidu": "uni -p mp-baidu",
    "dev:mp-jd": "uni -p mp-jd",
    "dev:mp-kuaishou": "uni -p mp-kuaishou",
    "dev:mp-lark": "uni -p mp-lark",
    "dev:mp-qq": "uni -p mp-qq",
    "dev:mp-toutiao": "uni -p mp-toutiao",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-xhs": "uni -p mp-xhs",
    "dev:quickapp-webview": "uni -p quickapp-webview",
    "dev:quickapp-webview-huawei": "uni -p quickapp-webview-huawei",
    "dev:quickapp-webview-union": "uni -p quickapp-webview-union",
    "build:h5": "uni build",
    "build:h5:ssr": "uni build --ssr",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:mp-baidu": "uni build -p mp-baidu",
    "build:mp-jd": "uni build -p mp-jd",
    "build:mp-kuaishou": "uni build -p mp-kuaishou",
    "build:mp-lark": "uni build -p mp-lark",
    "build:mp-qq": "uni build -p mp-qq",
    "build:mp-toutiao": "uni build -p mp-toutiao",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-xhs": "uni build -p mp-xhs",
    "build:quickapp-webview": "uni build -p quickapp-webview",
    "build:quickapp-webview-huawei": "uni build -p quickapp-webview-huawei",
    "build:quickapp-webview-union": "uni build -p quickapp-webview-union",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --open=false",
    "test:unit:ui": "vitest watch --coverage --ui",
    "test:coverage": "vitest run --open=false --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint && pnpm run lint:prettier",
    "lint:eslint": "eslint --fix ./src/**/*.{ts,vue}",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,json,jsx,ts,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint \"**/*.{css,less,scss}\" --fix",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-app-harmony": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-baidu": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-harmony": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-jd": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-lark": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-qq": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-xhs": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-quickapp-webview": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-ui": "^1.5.12",
    "@vue/devtools-api": "^6.6.4",
    "axios": "^1.18.1",
    "clipboard": "^2.0.11",
    "dayjs": "^1.11.18",
    "dehaze-sdk-js": "workspace:*",
    "pinia": "2.2.4",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5020120260710001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020120260710001",
    "@playwright/test": "^1.56.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "stylelint": "^16.25.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.3.0",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.9.3",
    "vite": "5.2.8",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.1"
  }
}
