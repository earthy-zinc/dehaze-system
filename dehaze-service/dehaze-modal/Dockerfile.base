# dehaze-modal 测试依赖基础镜像：只含依赖，不含业务代码
#
# 构建（上下文 = 仓库根）：
#   TAG=modal-base-$(sha256sum dehaze-service/dehaze-modal/uv.lock | cut -c1-12)
#   docker build -f dehaze-service/dehaze-modal/Dockerfile.base \
#     -t csighub.tencentyun.com/earthywu/dehaze-system:$TAG .
#   docker push csighub.tencentyun.com/earthywu/dehaze-system:$TAG
#
# tag 即内容指纹（当前 08dc5a158a40）：lock 未变 ⇒ 直接复用已推镜像，跳过重建；
# lock 变了 ⇒ 指纹自动变化，重建后需同步更新 Dockerfile 里 test 阶段的 FROM。
#
# 为什么 modal 要独立 base：lock 518 包、torch cu128 + nvidia-* + natten + pyiqa，
# 单次安装 15-30 分钟、体积 GB 级；固化后「改一行测试代码」不必重装依赖。
#
# 基座与运行态对齐：CUDA + cuDNN devel —— algorithm/（RIDCP/WPXNet/CFENViTDehazing）的
# DCN 算子首次使用时 JIT 编译需要 nvcc 与 ninja，natten 也要求 cuDNN 运行时。
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    UV_PYTHON=3.11 \
    UV_PROJECT_ENVIRONMENT=/app/dehaze-service/dehaze-modal/.venv \
    UV_LINK_MODE=copy

# libgl1/libglib2.0-0：opencv（DCP/MADN 等算法）运行库
RUN sed -i 's@/archive.ubuntu.com/@/mirrors.tuna.tsinghua.edu.cn/@g' /etc/apt/sources.list \
    && apt-get clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       libgl1 \
       libglib2.0-0 \
       build-essential \
       curl \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /uvx /bin/

WORKDIR /app/dehaze-service/dehaze-modal

# --frozen：严格按 uv.lock 还原（torch/natten 走 pyproject 里声明的 cu128 源与 find-links）；
# --no-cache：不把数 GB 下载缓存烤进镜像层（历史实测 10.2G → 19.7G）；
# --no-install-project：项目代码由测试镜像 COPY 进，本镜像不含业务代码。
# 默认含 [dependency-groups].dev（pytest/respx）。
COPY dehaze-service/dehaze-modal/pyproject.toml dehaze-service/dehaze-modal/uv.lock \
     dehaze-service/dehaze-modal/.python-version ./
RUN uv sync --frozen --no-cache --no-install-project

# 依赖自检：装错/装漏在 base 构建期就暴露，不必等测试镜像或 Pod
RUN .venv/bin/python -c "import torch, torchvision, cv2, natten, pyiqa, timm, einops, yacs, matplotlib, numpy; print('[deps-ok] torch', torch.__version__)" \
    && .venv/bin/python -c "import pytest, pytest_asyncio, respx; print('[test-deps-ok]')" \
    && .venv/bin/python -m pytest --version
