# dehaze-voice 测试依赖基础镜像：只含依赖，不含业务代码
#
# 构建（上下文 = 仓库根）：
#   TAG=voice-base-$(sha256sum dehaze-service/dehaze-voice/uv.lock | cut -c1-12)
#   docker build -f dehaze-service/dehaze-voice/Dockerfile.base \
#     -t csighub.tencentyun.com/earthywu/dehaze-system:$TAG .
#   docker push csighub.tencentyun.com/earthywu/dehaze-system:$TAG
#
# tag 即内容指纹（当前 3d01ce25e049）：lock 未变 ⇒ 直接复用已推镜像，跳过重建；
# lock 变了 ⇒ 指纹自动变化，重建后需同步更新 Dockerfile 里 test 阶段的 FROM。
#
# 为什么 voice 要独立 base：lock 433 包、funasr/modelscope + torch cu128 + torchaudio +
# piper-tts，单次安装 10-20 分钟、体积 GB 级；固化后「改一行测试代码」不必重装依赖。
#
# 基座用 python:3.11-slim（与运行态一致）：pyproject 的 [tool.uv.sources] 已把 torch/torchaudio
# 指向 PyTorch cu128 源，CUDA 运行库随 wheel 的 nvidia-* 依赖装入；测试以桩替换 ASR/TTS
# 引擎，不加载真实模型，无需 GPU。
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    UV_PROJECT_ENVIRONMENT=/app/dehaze-service/dehaze-voice/.venv \
    UV_LINK_MODE=copy

# funasr/modelscope/piper 的部分依赖无预编译 wheel 时需本地编译
RUN sed -i 's@//deb.debian.org@//mirrors.cloud.tencent.com@g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates curl git build-essential cmake \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /uvx /bin/

WORKDIR /app/dehaze-service/dehaze-voice

# --frozen：严格按 uv.lock 还原；--no-cache：不把下载缓存烤进镜像层；
# --no-install-project：项目代码由测试镜像 COPY 进，本镜像不含业务代码。
# 默认含 [dependency-groups].dev（pytest/pytest-asyncio）。
COPY dehaze-service/dehaze-voice/pyproject.toml dehaze-service/dehaze-voice/uv.lock \
     dehaze-service/dehaze-voice/.python-version ./
RUN uv sync --frozen --no-cache --no-install-project

# 依赖自检：装错/装漏在 base 构建期就暴露，不必等测试镜像或 Pod
RUN .venv/bin/python -c "import fastapi, torch, torchaudio, funasr, numpy; print('[deps-ok] torch', torch.__version__)" \
    && .venv/bin/python -c "import pytest, pytest_asyncio; print('[test-deps-ok]')" \
    && .venv/bin/python -m pytest --version
