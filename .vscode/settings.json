{
  "java.compile.nullAnalysis.mode": "automatic",
  "java.autobuild.enabled": false,
  "java.configuration.updateBuildConfiguration": "disabled",
  "java.configuration.annotationProcessing.enabled": true,
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms512m -Xlog:disable",
  "java.errors.incompleteClasspath.severity": "ignore",
  "java.maxConcurrentBuilds": 1,
  "java.import.generatesMetadataFilesAtProjectRoot": false,
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/target/**": true,
    "**/build/**": true,
    "**/.git/**": true,
    "**/logs/**": true,
    "**/dehaze-react-native/node_modules/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/target": true,
    "**/build": true,
    "**/.git": true,
    "**/logs": true
  },
  "cSpell.words": [
    "allprojects",
    "buildscript",
    "dcloudio",
    "kuaishou",
    "Peixin",
    "quickapp",
    "Subproject",
    "subprojects",
    "toutiao",
    "weapp",
    "weixin"
  ],
  "java.search.scope": "main"
}
