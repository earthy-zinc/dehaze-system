{
  // ============================================================
  // Java (Spring Boot / Android)
  // java.jdt.ls.java.home 与 java.configuration.runtimes 的 scope 是
  // machine-overridable，但这两项的值都是本机 JDK 绝对路径 —— 工作区设置会
  // 覆盖各人的用户设置，Windows（C:\Program Files\Java\jdk-21*）与 Linux
  // （/usr/local/java/jdk21）又不通用，故一律不在此处配置，只放各自机器的用户
  // 设置里；缺失时 JDT LS 会自动探测，可能选中过新版本（如 JDK 25）导致 Gradle
  // 同步失败，故每台机器都需显式配置。取值理由：
  //   java.jdt.ls.java.home —— 语言服务器自身运行 JDK，要求 >= 21；它同时
  //     是 Gradle daemon 的默认 JDK，故必须取本仓库最旧的 Gradle 也支持的
  //     版本（dehaze-android 8.7 / dehaze_flutter 8.12 / dehaze-react-native
  //     8.14.3）→ 21。java.import.gradle.java.home 因此不必单独配置。
  //   java.configuration.runtimes —— dehaze-java 字节码目标是 17（pom.xml 的
  //     maven.compiler.release=17），需注册 JavaSE-17 供其解析 JRE 容器；
  //     默认运行时取主项目的 17。参考取值：
  //       Windows：C:\Program Files\Java\jdk-21* / jdk-17
  //       Linux  ：/usr/local/java/jdk21 / jdk17
  //   java.jdt.ls.vmargs —— 同为 machine-overridable；扩展默认 -Xmx2G 对本仓库
  //     多模块并行编译偏紧，各机按自身内存自行设置（本机 31G 内存取
  //     -Xmx4G -Xms512m），与上面两项一样放各自机器的设置里。
  // ============================================================
  "java.compile.nullAnalysis.mode": "automatic",
  "java.autobuild.enabled": false,
  "java.configuration.updateBuildConfiguration": "disabled",
  "java.errors.incompleteClasspath.severity": "ignore",
  "java.maxConcurrentBuilds": 1,
  "java.import.generatesMetadataFilesAtProjectRoot": false,
  "java.search.scope": "main",
  "java.server.launchMode": "Standard",

  // dehaze_flutter/android 与 dehaze-react-native/android 都是 Gradle 工程
  // （前者 Kotlin DSL，后者 Groovy DSL）而非 Java 工程，导入只会失败并产生
  // 噪音，这里排除；默认 4 项必须一并带上，因为该设置是整体替换默认值而非追加。
  // Gradle 根项目按"目录"识别，故目录本身与目录内容必须分别排除：只写尾部
  // /** 的模式匹配不到 android 目录自身，JDT LS 仍会同步该项目，其 Flutter
  // 插件子项目随即触发跨盘符 buildDir 异常（pub cache 在 C 盘、build/ 在 E 盘，
  // Gradle 无法在两者间计算相对路径）。
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/dehaze_flutter/android",
    "**/dehaze_flutter/android/**",
    "**/dehaze-react-native/android",
    "**/dehaze-react-native/android/**"
  ],

  // ============================================================
  // Gradle（排除 node_modules 中的残留 Gradle wrapper）
  // ============================================================
  "gradle.nestedProjects": ["**/node_modules/**"],

  // ============================================================
  // 文件排除（性能关键）
  // ============================================================
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/target/**": true,
    "**/build/**": true,
    "**/.git/**": true,
    "**/logs/**": true,
    "**/dist/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.dart_tool/**": true,
    "**/oh_modules/**": true,
    "**/dehaze-react-native/node_modules/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/target": true,
    "**/build": true,
    "**/.git": true,
    "**/logs": true,
    "**/dist": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.dart_tool": true,
    "**/oh_modules": true
  },

  // ============================================================
  // 编辑器通用
  // ============================================================
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.minimap.enabled": false,
  "editor.suggest.snippetsPreventQuickSuggestions": false,

  // ============================================================
  // 文件关联
  // ============================================================
  "files.associations": {
    "*.css": "css",
    "*.scss": "scss",
    "*.less": "less",
    "*.ets": "typescript",
    "*.json5": "jsonc",
    "pubspec.yaml": "yaml",
    "*.dart": "dart"
  },

  // ============================================================
  // 格式化（Prettier 统一）
  // ============================================================
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "prettier.requireConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue"
  ],
  "stylelint.validate": ["css", "scss", "less", "postcss"],

  // ============================================================
  // 拼写检查
  // ============================================================
  "cSpell.words": [
    "allprojects",
    "buildscript",
    "dcloudio",
    "dehaze",
    "earthyzinc",
    "Gorm",
    "kuaishou",
    "Peixin",
    "quickapp",
    "Subproject",
    "subprojects",
    "toutiao",
    "weapp",
    "weixin",
    "unocss",
    "vitest",
    "pinia",
    "hvigor",
    "taroify",
    "uvicorn",
    "fastapi"
  ],

  // ============================================================
  // 语言特定
  // ============================================================
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.tabSize": 4
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.tabSize": 4
  },
  "[java]": {
    "editor.tabSize": 4
  },
  "[dart]": {
    "editor.tabSize": 2
  },

  // ============================================================
  // TypeScript / JavaScript
  // 旧命名空间 typescript.* / javascript.* 已弃用，TS 扩展 10.0 起统一为
  // js/ts.*（一个键同时管 JS 与 TS）。
  // 仓库根目录没有 package.json / node_modules，6 个 Node 子项目各自
  // 带 typescript 5.9.3，js/ts.tsdk.path 只能存一个值（window 级），
  // 因此不设；需要锁定版本时改用多根工作区（.code-workspace）。
  // ============================================================
  "js/ts.preferences.importModuleSpecifier": "relative",

  // ============================================================
  // UnoCSS（前端项目使用 UnoCSS 而非 Tailwind）
  // ============================================================
  "unocss.root": [
    "dehaze-front-react",
    "dehaze-front-vue"
  ],

  // ============================================================
  // Vitest（前端 + SDK 测试）
  // ============================================================
  "vitest.disableWorkspaceWarning": true,

  // ============================================================
  // Python
  // 项目统一用 Ruff（见 dehaze-python/pyproject.toml 的 [tool.ruff]），
  // isort 扩展自带语言服务器会与 ruff 的 isort 规则重复报错，故关闭。
  // 类型检查配置分两层：共享判定标准（typeCheckingMode / pythonPlatform）单点定义在
  // 仓库根 pyright.base.json；检查范围与 venv 由各 Python 子项目自己的 pyrightconfig.json
  // 描述（dehaze-python、dehaze-mcp-gateway、dehaze-service/dehaze-{llm,voice,modal}）。
  // 以仓库为单根打开工作区时生效的仍是仓库根 pyrightconfig.json（extends pyright.base.json，
  // 用 executionEnvironments 区分各子项目的导入搜索根与 app 包归属）——pyright 不会自动拾取
  // 子目录配置，故子项目配置只在单独打开该项目、或 CLI 逐项目执行
  // （dehaze-python/scripts/check.sh）时生效。
  // 这些文件存在时 pyright 会整体忽略本文件的 python.analysis.*（IDE 与 CLI 同源），
  // 所以 typeCheckingMode / exclude / extraPaths 不再在此保留副本，改配置请改上述文件。
  // 下面几项在 pyright 配置里没有对应键，保持在工作区：isort.serverEnabled 属 isort 扩展；
  // python.analysis.languageServerMode 属 Pylance（本机装的是 ms-pyright 扩展，不认此项）。
  // 解释器与导入解析由各 pyrightconfig.json 的 venvPath/venv 单点决定：不要在机器级写死
  // 本仓库的 venv 路径（会污染这台机器上的其他 Python 项目），也不必在此重复声明。
  // ============================================================
  "isort.serverEnabled": false,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.languageServerMode": "full",

  // 测试发现必须以 dehaze-python 为工作目录：否则 pytest 在仓库根执行，
  // 会去收集 dehaze-algorithm/notebook/*.py（缺 basicsr/torchsummary 直接报错），
  // 并执行 dehaze-mcp-gateway/tests/live_test.py（该文件顶层即跑实时用例）。
  "python.testing.cwd": "${workspaceFolder}/dehaze-python",

  // 不要在此处关闭或调整类型检查：口径由仓库根 pyright.base.json 单点决定，
  // 且存在 pyrightconfig.json 时 pyright 会忽略 VS Code 的 python.analysis.*，
  // 另设一处只会让 IDE 与终端门禁（scripts/check.sh）口径分裂。

  // ============================================================
  // 杂项
  // ============================================================
  "gitlens.advanced.blame.customArguments": ["--ignore-revs-file", ".git-blame-ignore-revs"],
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": false,
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m -Xlog:disable"
}
