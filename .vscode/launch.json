{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "msedge",
      "request": "launch",
      "name": "Edge",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "trace": true,
      "userDataDir": "${workspaceFolder}/.vscode/.msedge",
      "presentation": {
        "hidden": false,
        "group": "浏览器"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Chrome",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "trace": true,
      "userDataDir": "${workspaceFolder}/.vscode/.chrome",
      "presentation": {
        "hidden": false,
        "group": "浏览器"
      }
    },
    {
      "name": "dehaze-doc",
      "request": "launch",
      "cwd": "${workspaceFolder}/dehaze-doc",
      "runtimeArgs": ["run", "docs:dev"],
      "runtimeExecutable": "pnpm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "dehaze-front-vue",
      "request": "launch",
      "cwd": "${workspaceFolder}/dehaze-front-vue",
      "runtimeArgs": ["run", "dev"],
      "runtimeExecutable": "pnpm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "dehaze-front-react",
      "request": "launch",
      "cwd": "${workspaceFolder}/dehaze-front-react",
      "runtimeArgs": ["run", "dev"],
      "runtimeExecutable": "pnpm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "dehaze-front-desktop",
      "request": "launch",
      "cwd": "${workspaceFolder}/dehaze-front-react/desktop",
      "runtimeArgs": ["run", "dev"],
      "runtimeExecutable": "yarn",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "dehaze-react-native-dev-server",
      "command": "yarn run start",
      "cwd": "${workspaceFolder}/dehaze-react-native",
      "skipFiles": ["<node_internals>/**"],
      "request": "launch",
      "type": "node-terminal",
      "presentation": {
        "hidden": true,
        "group": "dehaze-react-native",
        "order": 1
      }
    },
    {
      "name": "dehaze-react-native",
      "command": "yarn run android",
      "cwd": "${workspaceFolder}/dehaze-react-native",
      "skipFiles": ["<node_internals>/**"],
      "request": "launch",
      "type": "node-terminal",
      "presentation": {
        "hidden": true,
        "group": "dehaze-react-native",
        "order": 2
      }
    },
    {
      "name": "dehaze-taro-h5",
      "request": "launch",
      "cwd": "${workspaceFolder}/dehaze-taro",
      "runtimeArgs": ["run", "dev:h5"],
      "runtimeExecutable": "pnpm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "presentation": {
        "hidden": false,
        "group": "dehaze-taro"
      }
    },
    {
      "name": "dehaze-taro-weapp",
      "request": "launch",
      "cwd": "${workspaceFolder}/dehaze-taro",
      "runtimeArgs": ["run", "dev:weapp"],
      "runtimeExecutable": "pnpm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "presentation": {
        "hidden": false,
        "group": "dehaze-taro"
      }
    },
    {
      "name": "dehaze-uniapp-h5",
      "request": "launch",
      "cwd": "${workspaceFolder}/dehaze-uniapp",
      "runtimeArgs": ["run", "dev:h5"],
      "runtimeExecutable": "pnpm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "presentation": {
        "hidden": false,
        "group": "dehaze-uniapp"
      }
    },
    {
      "name": "dehaze-uniapp-weixin",
      "request": "launch",
      "cwd": "${workspaceFolder}/dehaze-uniapp",
      "runtimeArgs": ["run", "dev:mp-weixin"],
      "runtimeExecutable": "pnpm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "presentation": {
        "hidden": false,
        "group": "dehaze-uniapp"
      }
    },
    {
      "name": "dehaze-java",
      "type": "java",
      "request": "launch",
      "mainClass": "com.pei.dehaze.SystemApplication",
      "projectName": "com.pei-dehaze-java"
    },
    {
      "name": "dehaze-python",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "windows": {
        "python": "${workspaceFolder}/dehaze-python/.venv/Scripts/python.exe"
      },
      "linux": {
        "python": "${workspaceFolder}/dehaze-python/.venv/bin/python"
      },
      "env": {
        "FLASK_APP": "dehaze-python/run.py",
        "FLASK_DEBUG": "1",
        "PYTHONPATH": "${workspaceFolder}/dehaze-python",
        "PATH": "${workspaceFolder}/dehaze-python/.venv/Scripts:${env:PATH}"
      },
      "args": ["run", "--no-debugger", "--no-reload"],
      "jinja": true,
      "autoStartBrowser": false
    },
    {
      "name": "dehaze-go",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/dehaze-go/main.go"
    },
    {
      "type": "java",
      "name": "Nacos",
      "request": "launch",
      "mainClass": "com.alibaba.nacos.Nacos",
      "projectName": "com.pei-pei-nacos",
      "presentation": {
        "hidden": true
      }
    },
    {
      "type": "java",
      "name": "PeiGatewayApplication",
      "request": "launch",
      "mainClass": "com.pei.gateway.PeiGatewayApplication",
      "projectName": "com.pei-pei-gateway",
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "dehaze-react-native-android",
      "configurations": [
        "dehaze-react-native-dev-server",
        "dehaze-react-native"
      ],
      "stopAll": true,
      "preLaunchTask": "启动安卓模拟器",
      "postDebugTask": "停止安卓模拟器",
      "presentation": {
        "hidden": false
      }
    }
  ]
}
